# ============================================
# OneWay Bot — backend environment (placeholders)
# ============================================

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Supabase (Project Settings -> API) ----
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Groq — primary LLM (https://console.groq.com/keys) ----
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# ---- OpenRouter — fallback LLM (https://openrouter.ai/keys) ----
# Used automatically when Groq fails or is rate-limited.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ---- Embeddings (optional; https://huggingface.co/settings/tokens) ----
# Without a token, a local fallback embedder is used automatically.
HUGGINGFACE_API_KEY=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- CORS: frontend URL(s), comma-separated. * allows all (dev only) ----
CORS_ORIGINS=http://localhost:3000

# ---- Optional: Cloudflare Turnstile captcha on the public chat endpoint ----
# Leave empty to disable captcha (dev mode).
TURNSTILE_SECRET_KEY=

# ---- Free-tier quotas ----
QUOTA_MESSAGES_PER_MONTH=200
QUOTA_DOCUMENTS_MAX=10
QUOTA_BOOKINGS_PER_MONTH=50

# ---- Rate limiting ----
RATE_LIMIT_PER_HOUR=300
CHAT_RATE_LIMIT_PER_MIN=20
